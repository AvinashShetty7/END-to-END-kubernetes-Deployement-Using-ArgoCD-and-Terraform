*_override.tf.json

# Terraform plan files
*.tfplan
*.plan

# CLI configuration
.terraformrc
terraform.rc

# Sensitive/private key files
*.pem
*.key

# Environment files
.env
.env.*

# OS files
.DS_Store
Thumbs.db