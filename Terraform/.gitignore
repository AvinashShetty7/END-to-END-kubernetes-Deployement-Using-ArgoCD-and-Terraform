# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Variable files - may contain secrets
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
